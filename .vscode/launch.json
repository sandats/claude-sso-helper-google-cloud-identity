{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "google-claude-auth status",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/google-claude-auth",
      "args": ["status"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "google-claude-auth login",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/google-claude-auth",
      "args": ["login"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Test internal/auth",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/internal/auth",
      "args": ["-test.count=1", "-test.v"]
    }
  ]
}
