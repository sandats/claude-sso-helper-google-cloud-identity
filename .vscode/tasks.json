{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "go: test",
      "type": "shell",
      "command": "go test -count=1 ./...",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "go: vet",
      "type": "shell",
      "command": "go vet ./...",
      "problemMatcher": ["$go"]
    },
    {
      "label": "go: build",
      "type": "shell",
      "command": "go build -trimpath -o bin/ ./cmd/...",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$go"]
    }
  ]
}
